<Window x:Class="ST10034968_POEPart3.User_Interface.AddRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ST10034968_POEPart3.User_Interface"
        mc:Ignorable="d"
        Title="Add Recipe" Height="825" Width="852">
    <Grid Background="#202020" Margin="0,0,0,-6">
        <Label x:Name="lblYourRecipe" Content="Your Recipe:" Style="{StaticResource defaultLabel}" Margin="0,93,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label" Content="Add a Step" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="239,561,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAddIngredient" Style="{StaticResource defaultButton}" Content="Add Ingredient"  HorizontalAlignment="Left" Margin="547,602,0,0" VerticalAlignment="Top" Background="#4C5B2333" Click="btnAddIngredient_Click" />
        <TextBox x:Name="txtAddStep" Style="{StaticResource defaultTextbox}" HorizontalAlignment="Left" Margin="136,603,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="290" />
        <Label x:Name="lblTitle" Style="{StaticResource heading}" Content="Add a Recipe" Margin="0,22,0,0" VerticalAlignment="Top" />
        <Button x:Name="btnAddStep" Content="Add Step" Style="{StaticResource defaultButton}" HorizontalAlignment="Left" Margin="239,645,0,0" VerticalAlignment="Top" Background="#2DBA1B1D" Click="btnAddStep_Click"/>
        <Button x:Name="btnAddRecipe" Content="Add" Style="{StaticResource defaultButton}" HorizontalAlignment="Center" Margin="0,724,0,0" VerticalAlignment="Top" FontSize="18" Background="#72564D4A" Padding="20,5,20,5" Click="btnAddRecipe_Click"/>
        <ListBox x:Name="lbxDisplayRecipe" Style="{StaticResource defaultListBox}" Margin="136,135,124,398" Background="#FF2D2626" FontSize="12"/>
        <Label x:Name="label1" Content="Recipe Name" Style="{StaticResource defaultLabel}" Margin="376,479,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBox x:Name="txtName" Style="{StaticResource defaultTextbox}" HorizontalAlignment="Left" Margin="357,521,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="165"/>
        <Button x:Name="btnRefresh" Content="Refresh" Style="{StaticResource defaultButton}" HorizontalAlignment="Left" Margin="635,417,0,0" VerticalAlignment="Top" FontSize="18" Background="#2DBA1B1D" Click="btnRefresh_Click"/>
        <TextBlock x:Name="txtBlockError" Style ="{StaticResource errorTextBlock}" HorizontalAlignment="Center" Margin="0,643,0,0"  VerticalAlignment="Top" Width="320"/>
    </Grid>
</Window>
