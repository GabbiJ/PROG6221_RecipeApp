<Window x:Class="ST10034968_POEPart3.User_Interface.AddIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ST10034968_POEPart3.User_Interface"
        mc:Ignorable="d"
        Title="Add Ingredient" Height="687" Width="800">
    <Grid Background="#202020" Margin="0,0,0,-6">
        <Label x:Name="lblTitle" Content="Add an Ingredient" Style="{StaticResource heading}"  HorizontalAlignment="Center" Margin="0,44,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label" Content="Name" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="115,127,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.254,0.582"/>
        <Label x:Name="label1" Content="Amount" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="115,208,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label2" Content="Unit of Measurement" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="341,208,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Style="{StaticResource defaultTextbox}" Margin="115,169,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="198"/>
        <Button x:Name="btnAdd" Content="Add" Style="{StaticResource defaultButton}" HorizontalAlignment="Center" Margin="0,604,0,0" VerticalAlignment="Top" Width="100" Background="#72564D4A" Click="btnAdd_Click"/>
        <TextBox x:Name="txtQuantity" Style="{StaticResource defaultTextbox}" HorizontalAlignment="Left" Margin="115,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="99"/>
        <ComboBox x:Name="cmbUnitOfMeasurement" HorizontalAlignment="Left" Margin="350,250,0,0" VerticalAlignment="Top" Width="118"/>
        <TextBox x:Name="txtOtherUnitOfMeasurement" Style="{StaticResource defaultTextbox}" HorizontalAlignment="Left" Margin="486,250,0,0" TextWrapping="Wrap" Text="Other" VerticalAlignment="Top" Width="154" Foreground="#FF4A4A4A" GotFocus="txtOtherUnitOfMeasurement_GotFocus" LostFocus="txtOtherUnitOfMeasurement_LostFocus" />
        <Label x:Name="lblErrorMessage" Style="{StaticResource defaultLabel}" Margin="345,375,0,0" VerticalAlignment="Top" FontSize="16" Foreground="#FFBA1B1D" HorizontalAlignment="Left"/>
        <Label x:Name="label3" Content="Calories" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="115,292,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCalories" Style="{StaticResource defaultTextbox}" HorizontalAlignment="Left" Margin="115,334,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="label4" Content="Food Group"  Style="{StaticResource defaultLabel}" Margin="0,292,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbFoodGroup" HorizontalAlignment="Left" Margin="350,334,0,0" VerticalAlignment="Top" Width="118"/>
        <Label x:Name="label5" Content="Food Group Examples:" Style="{StaticResource defaultLabel}" HorizontalAlignment="Left" Margin="350,375,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label x:Name="lblFoodGroupInfo" Style="{StaticResource defaultLabel}"  HorizontalAlignment="Left" Margin="350,414,0,0" VerticalAlignment="Top" FontSize="12" BorderThickness="1,1,1,1">
            <Label.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFBA1B1D"/>
                    <GradientStop Color="#FF5B2333" Offset="1"/>
                    <GradientStop Color="#FF564D4A" Offset="0.5"/>
                </LinearGradientBrush>
            </Label.BorderBrush>
        </Label>

    </Grid>
</Window>
