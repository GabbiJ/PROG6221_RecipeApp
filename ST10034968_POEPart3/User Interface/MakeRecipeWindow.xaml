<Window x:Class="ST10034968_POEPart3.User_Interface.MakeRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ST10034968_POEPart3.User_Interface"
        mc:Ignorable="d"
        Title="MakeRecipeWindow" Height="645" Width="800">
    <Grid Background="#202020" Height="623" VerticalAlignment="Top">
        <TextBlock x:Name="txtBlockIngredients"  HorizontalAlignment="Center" Margin="0,159,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FFF7F4F3" FontSize="14" Width="630"/>
        <Label x:Name="lblName" Content="Label" Style="{StaticResource heading}" Margin="0,48,0,0" VerticalAlignment="Top"/>
        <ListBox ItemsSource="{Binding}" Style="{StaticResource defaultListBox}" Margin="85,290,91,109">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding}" Foreground="#FFF7F4F3" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label x:Name="label" Style="{StaticResource defaultLabel}" Content="Ingredients:" HorizontalAlignment="Left" Margin="85,117,0,0" VerticalAlignment="Top">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFBA1B1D"/>
                    <GradientStop Color="#FF8C2945" Offset="1"/>
                    <GradientStop Color="#FF96857F" Offset="0.5"/>
                    <GradientStop Color="#FF96837D" Offset="0.5"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Label x:Name="label2" Style="{StaticResource defaultLabel}" Content="Steps:" HorizontalAlignment="Left" Margin="85,248,0,0" VerticalAlignment="Top">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFBA1B1D"/>
                    <GradientStop Color="#FF8C2945" Offset="1"/>
                    <GradientStop Color="#FF96857F" Offset="0.5"/>
                    <GradientStop Color="#FF96837D" Offset="0.5"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Button x:Name="btnBack" Content="Back" Style="{StaticResource defaultButton}" HorizontalAlignment="Left" Margin="370,565,0,0" VerticalAlignment="Top" Background="#4C5B2333" Click="btnBack_Click"/>

    </Grid>
</Window>
